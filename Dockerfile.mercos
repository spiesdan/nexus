# Worker do Mercos — Chromium isolado, fora do app e do worker do agente.
#
# A imagem oficial do Playwright já traz o Chromium na versão exata do
# `@playwright/test` do lockfile. Instalar Chromium por cima do Alpine seria
# maior, mais lento e sujeito a mismatch de versão — o modo de falha clássico
# é o browser abrir e o protocolo não casar.
FROM mcr.microsoft.com/playwright:v1.64.0-noble

# Procedência (doutrina de packaging, invariante 2). Sem estes rótulos a imagem
# publicada não diz de onde veio — e o `docker image inspect` da VPS não
# distingue uma imagem do CI de uma construída à mão no mesmo host.
LABEL org.opencontainers.image.source="https://github.com/spiesdan/nexus" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="DeskcommCRM mercos"

# A versão vem do CI no build (publish-image.yml passa `--build-arg`). É o que
# faz a imagem se identificar; sem ela o host não sabe o que está rodando.
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION

WORKDIR /app
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .

# A credencial NÃO entra na imagem: vem do ambiente do serviço no compose.
ENV NODE_ENV=production
EXPOSE 8791
CMD ["node", "workers/mercos/main.mjs"]
