<?xml version="1.0" encoding="utf-8"?>
<!--
  SÓ PARA A BUILD DE DEBUG — testes no emulador.

  O dreno aceito precisa de um servidor alcançável pelo aparelho, e o caminho
  sem produção é `adb reverse tcp:8787 tcp:8787` + `http://10.0.2.2:8787`.
  Desde o Android 9 (targetSdk 28+) cleartext é bloqueado por padrão — inclusive
  para `localhost` —, então a build de DEBUG declara uma config que libera
  cleartext APENAS para o host da máquina e o loopback. A build de release não
  enxerga este arquivo (source set `debug`), então produção continua só HTTPS.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config_debug" />
</manifest>
