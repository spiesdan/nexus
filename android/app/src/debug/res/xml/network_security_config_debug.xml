<?xml version="1.0" encoding="utf-8"?>
<!--
  Rede de teste do emulador (debug only): cleartext liberado SÓ para o host da
  máquina (`10.0.2.2`), o loopback e o `localhost` do Capacitor. Qualquer outro
  domínio continua exigindo TLS — a regra não afrouxa a build de release porque
  este arquivo só existe no source set `debug`.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
