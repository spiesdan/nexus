{
  "name": "nexus/fiscal-sidecar",
  "description": "Sidecar emissor de NF-e (sped-nfe) do Nexus. Rede privada, nunca exposto.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-soap": "*",
    "ext-xml": "*",
    "ext-zip": "*",
    "nfephp-org/sped-nfe": "^5.0",
    "nfephp-org/sped-da": "^1.1"
  },
  "autoload": {
    "psr-4": { "FiscalSidecar\\": "src/" }
  },
  "config": {
    "sort-packages": true
  }
}
